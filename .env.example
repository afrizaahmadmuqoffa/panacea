# Copy to .env.local and fill the values.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
ALLOW_OPEN_REGISTRATION=true

# Supabase
# Use the publishable key in the browser and the secret key only on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# Supabase Storage
SUPABASE_STORAGE_BUCKET_CLAIM_IMAGES=claim-images
SUPABASE_STORAGE_BUCKET_REPORT_ATTACHMENTS=report-attachments
SUPABASE_STORAGE_BUCKET_KB_DOCUMENTS=kb-documents

# Gemini
# Fill these with models available in your Google AI Studio account.
# Gemini is also required for embeddings even when AI_PROVIDER=groq.
GEMINI_API_KEY=
GEMINI_MODEL_GENERATION=
GEMINI_MODEL_MODERATION=
GEMINI_MODEL_EMBEDDING=
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=2

# AI provider for text + vision (extraction, verification, moderation, clarification)
# gemini | groq
AI_PROVIDER=gemini

# Groq
GROQ_API_KEY=
GROQ_MODEL_GENERATION=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_MODERATION=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_MS=45000
GROQ_MAX_RETRIES=2
GROQ_MAX_OUTPUT_TOKENS=8192

# Europe PMC
EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
EUROPE_PMC_CONTACT_EMAIL=
EUROPE_PMC_PAGE_SIZE=10
EUROPE_PMC_TIMEOUT_MS=15000
EUROPE_PMC_CACHE_TTL_SECONDS=604800

# Retrieval
KB_CHUNK_TARGET_TOKENS=600
KB_CHUNK_OVERLAP_TOKENS=80
KB_TOP_K=8
KB_MIN_SCORE=0.55
KB_MIN_EVIDENCE_COUNT=3
RRF_K=60

# Abuse limits
CLAIM_RATE_LIMIT_PER_HOUR=20
GAME_SESSIONS_PER_DAY=5
GAME_QUESTIONS_PER_SESSION=10
GAME_XP_BASE=10
GAME_XP_STREAK_BONUS=5
GAME_XP_STREAK_BONUS_MAX=3
RATE_LIMIT_WINDOW_SECONDS=3600

# Upload limits
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_KB_DOCUMENT_BYTES=10485760

# Jobs
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
JOB_BACKOFF_SECONDS=30

# Server secrets
# Generate with: openssl rand -base64 32
CRON_SECRET=
INTERNAL_WORKER_SECRET=

# First admin bootstrap
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
